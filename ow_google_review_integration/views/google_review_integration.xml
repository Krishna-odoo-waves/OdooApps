<odoo>
    <record id="view_google_review_integration_list" model="ir.ui.view">
        <field name="name">google.review.integration.list</field>
        <field name="model">google.review.integration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="client_id"/>
                <field name="client_secret"/>
                <field name="access_token"/>
                <field name="refresh_token"/>
                <field name="redirect_url"/>
            </list>
        </field>
    </record>

    <record id="view_google_review_integration_form" model="ir.ui.view">
        <field name="name">google.review.integration.form</field>
        <field name="model">google.review.integration</field>
        <field name="arch" type="xml">
            <form>
                    <header>
                    <button name="google_connection" string="Google Connect" icon="fa-plug"
                                type="object" class="oe_highlight" invisible="state == 'connected'"/>
                        <button name="test_google_connection" string="Test Connection" icon="fa-plug"
                                type="object" class="oe_highlight"/>
                        <button name="set_to_draft" string="Set to Draft" icon="fa-undo"
                                type="object" class="oe_highlight"/>
                        <button name="get_accounts" string="Get Accounts"
                                type="object" class="oe_highlight"/>
                        <button name="get_locations" string="Get Locations"
                                type="object" class="oe_highlight"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="client_id"/>
                            <field name="client_secret"/>
                            <field name="account_ids" widget="many2many_tags"/>
                            <field name="location_id" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="access_token"/>
                            <field name="refresh_token"/>
                            <field name="redirect_url"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_google_review_integrations" model="ir.actions.act_window">
        <field name="name">Google Review Integration</field>
        <field name="res_model">google.review.integration</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_google_review_integration_root" name="Google Connection" action="action_google_review_integrations"/>
</odoo>
