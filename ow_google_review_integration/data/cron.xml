<?xml version="1.0" encoding="utf-8"?>
<!-- #######################   ODOO WAVES   ##################### -->
<!-- ###########   odoowaves.solution@gmail.com    #############- -->
<odoo>
   <data noupdate="0">
       <record id="gmail_token_refresh" model="ir.cron">
           <field name="name">Gmail Token Refresh</field>
           <field name="model_id" ref="model_google_review_integration"/>
           <field name="active" eval="True"/>
           <field name="state">code</field>
           <field name="code">model.test_google_connection(env)</field>
           <field name="user_id" ref="base.user_root"/>
           <!-- <field name="numbercall">-1</field> -->
           <field name='interval_number'>30</field>
           <field name='interval_type'>minutes</field>
       </record>
       <record id="get_reviews" model="ir.cron">
           <field name="name">Auto Reply to Review</field>
           <field name="model_id" ref="model_google_review_integration"/>
           <field name="active" eval="True"/>
           <field name="state">code</field>
           <field name="code">model.auto_reply_to_reviews(env)</field>
           <field name="user_id" ref="base.user_root"/>
           <!-- <field name="numbercall">-1</field> -->
           <field name='interval_number'>30</field>
           <field name='interval_type'>minutes</field>
       </record>
   </data>
</odoo>
