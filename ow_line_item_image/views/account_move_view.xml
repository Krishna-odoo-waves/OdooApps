<odoo>
    <record id="ow_account_move_view_form" model="ir.ui.view">
        <field name="name">ow.account.move.view.form.inherit.ow_line_item_image</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
           <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                <field name="ow_image_128" widget='image' options='{"zoom": true}' optional="show"/>
           </xpath>
        </field>
    </record>
</odoo>
