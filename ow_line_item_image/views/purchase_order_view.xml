<odoo>
    <record id="ow_purchase_order_view_form" model="ir.ui.view">
        <field name="name">ow.purchase.order.view.form.inherit.ow_line_item_image</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
           <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="before">
                <field name="ow_image_128" widget='image' options='{"zoom": true}' optional="show"/>
           </xpath>
        </field>
    </record>
</odoo>
